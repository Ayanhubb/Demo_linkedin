# Copy to .env and fill the values locally. Do not commit .env.
# Generate a Fernet key for TOKEN_ENCRYPTION_KEY:
#   py -3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Compose gives the API its own DATABASE_URL and REDIS_URL on the Docker network.
# The API is published on http://localhost:8080 and the UI on http://localhost:5173.

# Local demo database. Override these outside your own machine.
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=linkedin_scheduler

DATABASE_URL=
REDIS_URL=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=

SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=

# Optional. The app defaults these when they are unset.
# LINKEDIN_SCOPES=w_member_social
# CELERY_BEAT_INTERVAL_SECONDS=15
# FRONTEND_ORIGIN is accepted as an alias of FRONTEND_URL.
